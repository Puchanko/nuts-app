<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="jp.wits.dev.mapper.RoleMapper">

	<resultMap
		id="roleResultMap"
		type="jp.wits.dev.model.entity.Role">
		<id
			property="id"
			column="id" />
		<result
			property="roleCode"
			column="role_code" />
		<result
			property="roleName"
			column="role_name" />
	</resultMap>
	
	<select
		id="findByRoleCode"
		resultMap="roleResultMap">
		SELECT
			id,
			role_code,
			role_name
		FROM
			roles
		WHERE
			role_code = #{roleCode}
	</select>
	
</mapper>